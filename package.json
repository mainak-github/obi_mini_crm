{
  "name": "miui-crm",
  "version": "1.0.0",
  "private": true,
  "description": "A practical full-stack CRM with MIUI-inspired UI, role-aware APIs, and real-time notifications.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w @miui-crm/api",
    "dev:web": "npm run dev -w @miui-crm/web",
    "build": "npm run build -w @miui-crm/api && npm run build -w @miui-crm/web",
    "test": "npm run test -w @miui-crm/api",
    "db:generate": "npm run prisma:generate -w @miui-crm/api",
    "db:migrate": "npm run prisma:migrate -w @miui-crm/api",
    "db:seed": "npm run prisma:seed -w @miui-crm/api",
    "db:studio": "npm run prisma:studio -w @miui-crm/api"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
